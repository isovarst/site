/* =====================================================================
   Course — analytische Pistenfunktion (Höhe, Normale, Features)
   Downhill = +Z. Piste folgt einer Mittellinie cx(z).
   ===================================================================== */
class Course {
  constructor(T = TRACK) {
    this.T = T; this.zf = T.len;
    this.cx0 = T.cx0 !== undefined ? T.cx0 : -T.cx.reduce((s, [A, , ph]) => s + A * Math.sin(ph), 0); // Start bei x≈0
    this.runT = 90;           // Übergang in den Auslauf [m]
    this.gEnd = 0.04;
    this.Fzf = this.Fraw(this.zf);
    this.g0 = this.gradeRaw(this.zf);
  }
  cx(z)   { let s = this.cx0; for (const [A, k, ph] of this.T.cx) s += A * Math.sin(z * k + ph); return s; }
  cxp(z)  { let s = 0; for (const [A, k, ph] of this.T.cx) s += A * k * Math.cos(z * k + ph); return s; }
  cxpp(z) { let s = 0; for (const [A, k, ph] of this.T.cx) s -= A * k * k * Math.sin(z * k + ph); return s; }
  width(z){ const w = this.T.w; let s = w[0]; for (let i = 1; i < w.length; i++) s += w[i][0] * Math.sin(z * w[i][1] + w[i][2]); return s; } // halbe Pistenbreite
  // Gefälle (positiv = bergab pro Meter) und dessen Stammfunktion (Höhe)
  gradeRaw(z) { const g = this.T.g; let s = g[0]; for (let i = 1; i < g.length; i++) s -= g[i][0] * Math.sin(z * g[i][1] + g[i][2]); return s; }
  Fraw(z) { const g = this.T.g; let s = g[0] * z; for (let i = 1; i < g.length; i++) s += (g[i][0] / g[i][1]) * Math.cos(z * g[i][1] + g[i][2]); return -s; }
  grade(z) {
    if (z <= this.zf) return this.gradeRaw(z);
    const t = z - this.zf; if (t >= this.runT) return this.gEnd;
    return this.g0 + (this.gEnd - this.g0) * t / this.runT;
  }
  y0(z) {
    if (z <= this.zf) return this.Fraw(z);
    const t = z - this.zf, T = this.runT, g0 = this.g0, g1 = this.gEnd;
    if (t < T) return this.Fzf - (g0 * t + (g1 - g0) * t * t / (2 * T));
    return this.Fzf - (g0 * T + (g1 - g0) * T / 2) - g1 * (t - T);
  }
  // Netze an der Kurvenaußenseite bei starker Krümmung: -1 / 0 / +1
  netSide(z) { if (z < 20 || z > this.zf + 60) return 0; const k = this.cxpp(z); return Math.abs(k) > 0.0021 ? -sign(k) : 0; }
  roller(c) { // Kuppe in Zelle c (90 m)
    if (c < 2 || c * 90 > this.zf - 150 || hash1(c * 3.1 + 7) > 0.5) return null;
    return { z: c * 90 + 45 + (hash1(c * 5.3) - 0.5) * 30, H: 1.0 + hash1(c * 9.7) * 1.6, s: 6 + hash1(c * 2.9) * 4 };
  }
  kicker(c) { // Kicker in Zelle c (Rastergröße je Course)
    const K = this.T.kickCell;
    if (c < 1 || c * K > this.zf - 220 || hash1(c * 11.3 + 1) > this.T.kickP) return null;
    const z = c * K + K * 0.28 + hash1(c * 4.1) * K * 0.43;
    return { z, d: (hash1(c * 6.7) - 0.5) * this.width(z) * 0.8, H: 0.95 + hash1(c * 8.3) * 0.65, L: 10 };
  }
  features(z, d) {
    let y = 0;
    const rc = Math.floor(z / 90);
    for (let c = rc - 1; c <= rc + 1; c++) {
      const r = this.roller(c); if (!r) continue;
      const dz = z - r.z; if (Math.abs(dz) < r.s * 4) y += r.H * Math.exp(-dz * dz / (2 * r.s * r.s));
    }
    const kc = Math.floor(z / this.T.kickCell);
    for (let c = kc - 1; c <= kc; c++) {
      const k = this.kicker(c); if (!k) continue;
      const t = (z - k.z) / k.L; if (t < 0 || t > 1.3) continue;
      const lat = 1 - smoothstep(3.0, 4.2, Math.abs(d - k.d)); if (lat <= 0) continue;
      const prof = t <= 1 ? k.H * t * t : k.H * Math.pow(1 - (t - 1) / 0.3, 2); // Parabel-Rampe, steile Rückseite
      y += prof * lat;
    }
    return y;
  }
  // Aufstehpunkt: nächste Stelle talwärts, die bergab geht und nicht auf Kicker/Kuppe liegt
  safeZ(z, d) {
    for (let k = 0; k < 30 && z < this.zf; k++) { const x = this.cx(z) + d; if ((this.height(x, z + 1.5) - this.height(x, z - 1.5)) / 3 < -0.06 && this.features(z, d) < 0.05) return z; z += 3; }
    return z;
  }
  // Präparationsgrad 1 = Piste, 0 = Tiefschnee
  groom(x, z) { const d = x - this.cx(z); return 1 - smoothstep(this.width(z) - 1.5, this.width(z) + 7, Math.abs(d)); }
  height(x, z) {
    const c = this.cx(z), d = x - c, W = this.width(z), ad = Math.abs(d);
    let y = this.y0(z);
    y += -0.7 * this.cxp(z) * this.grade(z) * d;        // Querneigung: Falllinie folgt grob der Piste
    const edge = smoothstep(W - 1.5, W + 7, ad), g = 1 - edge;
    y += 0.0015 * d * d * g;                             // leichte Mulde
    const o = Math.max(0, ad - W), far = smoothstep(W + 4, W + 60, ad);
    y += smoothstep(0, 7, o) * 0.9;                      // Böschung am Pistenrand
    // offener Hang: links Bergseite (steigt), rechts Talseite: erst steiler, dann flacher Talboden (konkav -> Blick ins Tal frei)
    y += d < 0 ? o * smoothstep(0, 40, o) * 0.13 : -(38 * (1 - Math.exp(-o / 140)) + 0.02 * o) * smoothstep(0, 25, o);
    y += edge * vnoise(x * 0.11, z * 0.11) * 0.35;       // Tiefschnee-Wellen
    y += far * (fbm(x * 0.012, z * 0.012, 4) + 0.3) * 16; // sanfte Hügel
    y += smoothstep(W + 150, W + 400, ad) * fbm(x * 0.005 + 7, z * 0.005, 3) * 40; // Fernrelief
    y += g * vnoise(x * 0.25, z * 0.25) * 0.05;          // leichte Pistenunebenheit
    if (g > 0.001) y += this.features(z, d) * g;
    return y;
  }
  // Normale per zentralen finiten Differenzen (keine Raycasts)
  normal(x, z, out) {
    const e = 0.25;
    const hx = this.height(x + e, z) - this.height(x - e, z);
    const hz = this.height(x, z + e) - this.height(x, z - e);
    return out.set(-hx / (2 * e), 1, -hz / (2 * e)).normalize();
  }
}


      this.rank = rank; this.rivalText = 'Place ' + rank + '/' + (1 + this.rivals.filter((rv) => rv.active).length);
    } else this.rivalText = '';
    // Skifahrer + Kollision (Kapsel vs Kapsel) + Near Miss
    const progress = clamp(p.pos.z / this.course.zf, 0, 1);
    this.skiers.update(dt, p.pos.z, progress);
    this.capA.copy(this.rp).addScaledVector(this.rUp, 0.25); this.capB.copy(this.rp).addScaledVector(this.rUp, 1.45);
    const canHit = this.state === 'play' && this.riderMode === 'ride' && this.invuln <= 0 && !this.finished;
    const hit = this.skiers.checkPlayer(this.capA, this.capB, p.pos.z, p.speed, canHit);
    if (hit && canHit) { p.crash('skier'); this.startCrash('skier'); }
    this.contacts(dt);
    // Gates & Stars
    if (this.state === 'play' && !this.finished) {
      const zc = this.riderMode === 'ragdoll' ? Math.max(p.pos.z, this.ragdoll.p[J.PELVIS].z) : p.pos.z;
      this.tmp3.copy(this.rp).addScaledVector(this.rUp, 0.7);
      this.chal.update(dt, zc, p.pos.x, this.tmp3, this.riderMode === 'ride', (ok) => this.onGate(ok), () => this.onStar());
    } else this.chal.update(dt, -1e9, 0, this.tmp3, false, () => {}, () => {});
    // Score & Ziel
    this.score.update(dt, p, this.state === 'play' && this.riderMode === 'ride' && !this.finished);
    if (this.state === 'play' && !this.finished && p.pos.z > this.course.zf) {
      this.finished = true; this.finishTime = this.runTime + this.penalty; this.hud.pop('Ziel!', fmtTime(this.finishTime)); this.audio.pop(2); this.audio.pop(1.5); this.audio.musicFinish();
    }
    if (this.finished && this.state === 'play') { this.finishT += dtReal; if (this.finishT > 2.2) this.showFinish(); }
    this.fillCamTarget(); this.rig.update(dtReal, this.camT);
    this.updateGateMark(); this.updateTags(); this.updateTrickHint();
  }
  // Landehilfe in der Luft: Ring mit Ist-Drehung und Vorhersage „wenn du jetzt loslässt“, dazu ein kurzer Tipp
  updateTrickHint() {
    if (!this.trEl) {
      this.trEl = $('trick'); this.trTxt = $('trTxt'); this.trKey = $('trKey'); this.trNow = $('trNow'); this.trPred = $('trPred');
      const arc = (r, a) => { const x = r * Math.sin(a); return 'M ' + (-x).toFixed(2) + ' ' + (-r * Math.cos(a)).toFixed(2) + ' A ' + r + ' ' + r + ' 0 0 1 ' + x.toFixed(2) + ' ' + (-r * Math.cos(a)).toFixed(2); };
      $('trOk').setAttribute('d', arc(38, CONFIG.landFlipClean)); $('trWarn').setAttribute('d', arc(38, CONFIG.landFlipCrash));
    }
    const p = this.phys, C = CONFIG, c = this.course, el = this.trEl;
    let show = false;
    if (this.state === 'play' && this.riderMode === 'ride' && !p.grounded && p.airTime > 0.05 && !this.finished) {
      // Landezeitpunkt: ballistische Flugbahn gegen das Gelände
      let tl = 1.2;
      for (let t = 0.03; t < 3; t += 0.03) { if (p.pos.y + p.vel.y * t - 0.5 * C.gravity * t * t <= c.height(p.pos.x + p.vel.x * t, p.pos.z + p.vel.z * t)) { tl = t; break; } }
      const velYaw = Math.atan2(p.vel.x, p.vel.z), hs = Math.hypot(p.vel.x, p.vel.z);
      const flipping = Math.abs(p.flip) > 0.25 || Math.abs(p.flipRate) > 1.5;
      const yawErr = hs > 3 ? wrapAngle(p.yaw - velYaw) : 0, spinning = hs > 3 && (Math.abs(yawErr) > 0.3 || Math.abs(p.yawRate) > 1.5);
      if (flipping || spinning) {
        show = true;
        // Loslassen: Drehrate klingt exponentiell ab (Flip 9/s, Spin 6/s). Halten: Rate läuft auf die volle Drehrate hoch.
        const now = flipping ? p.flip : yawErr, rate = flipping ? p.flipRate : p.yawRate, k = flipping ? 9 : 6, e = 1 - Math.exp(-k * tl);
        const target = (Math.sign(rate) || Math.sign(now) || 1) * (flipping ? C.flipRate : C.airSpinRate);
        const relU = now + rate / k * e, holdU = now + target * tl - (target - rate) / k * e;
        const rel = wrapAngle(relU), eR = Math.abs(rel), eH = Math.abs(wrapAngle(holdU)), turns = Math.round(Math.abs(relU) / TAU);
        const holding = flipping ? (this.pin.tuck > 0.5 || this.pin.brake > 0.5) : Math.abs(this.pin.steer) > 0.3;
        const clean = C.landFlipClean, crash = flipping ? C.landFlipCrash : C.landCrashAngle;
        const touch = document.body.classList.contains('touch'), dirKey = flipping ? (now > 0 ? 'W' : 'S') : (rate < 0 ? '→ / D' : '← / A');
        const keyHint = touch ? (flipping ? (now > 0 ? 'Stick hoch' : 'Stick runter') : 'Stick seitlich') : dirKey + ' halten';
        let cls = 'ok', txt = '', key = '';
        if (holding) {
          // Rangfolge: sauber landen > sicher (abbrechen/loslassen) > Drehung riskant zu Ende bringen
          const stop = turns === 0 ? 'Stop!' : 'Release!';
          if (turns === 0 && eR <= clean) { if (eH > crash) { cls = 'warn'; txt = 'Stop!'; } }        // Drehung beginnt: nur Ring, außer die Zeit reicht nicht
          else if (eR <= clean) { cls = 'ok go'; txt = 'Release!'; }                                        // volle Drehung geschafft
          else if (eH <= clean) { cls = 'warn'; txt = 'Keep Spinning!'; key = keyHint; }
          else if (eR <= crash) { cls = 'warn'; txt = stop; }
          else if (eH <= crash) { cls = 'warn'; txt = 'Keep Spinning!'; key = keyHint; }
          else { cls = 'bad'; txt = eH < eR ? 'Keep Spinning!' : stop; if (eH < eR) key = keyHint; }
        } else {
          if (eR <= clean) txt = '✓';
          else if (eH < eR) { cls = eH <= crash ? 'warn' : 'bad'; txt = 'Keep Spinning!'; key = keyHint; }
          else { cls = eR <= crash ? 'warn' : 'bad'; txt = eR <= crash ? 'Close' : 'Crash Risk!'; }
        }
        if (p.airTime < 0.15) { cls = 'ok'; txt = ''; key = ''; } // direkt nach dem Absprung: Vorhersage noch unzuverlässig (Kante) -> nur Ring
        el.className = 'on ' + cls; this.trTxt.textContent = txt; this.trKey.textContent = key;
        this.trNow.setAttribute('transform', 'rotate(' + (now * 180 / Math.PI).toFixed(1) + ')');
        this.trPred.setAttribute('transform', 'rotate(' + (rel * 180 / Math.PI).toFixed(1) + ')');
      }
    }
    if (!show && el.classList.contains('on')) { el.className = ''; this.trTxt.textContent = ''; this.trKey.textContent = ''; }
  }
  // Namensschild über jedem Rivals (dezent, blendet mit der Entfernung aus)
  updateTags() {
    if (!this.tagEls) { const box = $('tags'); this.tagEls = this.rivals.map((rv) => { const d = document.createElement('div'); d.className = 'tag'; d.innerHTML = '<i style="background:#' + rv.def.col.jacket.toString(16).padStart(6, '0') + '"></i>' + rv.def.name; box.appendChild(d); return d; }); }
    const show = this.state === 'play' || this.state === 'countdown';
    this.rivals.forEach((rv, i) => {
      const el = this.tagEls[i];
      if (!show || !rv.active || !rv.rider.root.visible) { el.style.display = 'none'; return; }
      const head = rv.wj[J.HEAD], dist = head.distanceTo(this.camera.position), v = this.tmp2.copy(head).addScaledVector(rv.st.up, 0.55).project(this.camera);
      if (v.z > 1 || dist > 160 || Math.abs(v.x) > 1.1 || Math.abs(v.y) > 1.1) { el.style.display = 'none'; return; }
      el.style.display = 'block'; el.style.opacity = (0.9 * (1 - smoothstep(60, 160, dist))).toFixed(2);
      el.style.transform = `translate(${((v.x * 0.5 + 0.5) * innerWidth).toFixed(0)}px,${((-v.y * 0.5 + 0.5) * innerHeight).toFixed(0)}px) translate(-50%,-100%)`;
    });
  }
  // Pfeil + Entfernung über dem nächsten Tor; außerhalb des Bildes an den Rand geklemmt
  updateGateMark() {
    const el = this.gateMarkEl || (this.gateMarkEl = $('gateMark')), ch = this.chal, g = ch.gates[ch.gateNext], p = this.phys;
    const dist = g ? g.z - p.pos.z : 1e9;
    if (!g || this.state !== 'play' || this.finished || dist > 450 || dist < -2) { el.style.display = 'none'; return; }
    const v = this.tmp2.set(g.x, this.course.height(g.x, g.z) + 3.1, g.z).project(this.camera);
    if (v.z > 1) { el.style.display = 'none'; return; }
    const W = innerWidth, H = innerHeight, x = clamp((v.x * 0.5 + 0.5) * W, 40, W - 40), y = clamp((-v.y * 0.5 + 0.5) * H, 70, H - 40);
    el.style.display = 'block'; el.style.transform = `translate(${x.toFixed(0)}px,${y.toFixed(0)}px) translate(-50%,-100%)`;
    el.className = g.col === 0xd7263d ? 'red' : 'blue'; el.lastChild.textContent = Math.max(0, Math.round(dist)) + ' m';
  }
  emitRideFx(FIX) {
    const p = this.phys; if (!p.grounded || p.speed < 3) { if (!p.grounded) this.trail.breakLine(); return; }
    const es = sign(p.edge), f = p.f, r = p.r, n = p.n;
    // Board-Spur an der belasteten Kante
    this.tmp.copy(p.pos).addScaledVector(r, es * 0.1 * Math.min(1, Math.abs(p.edge) * 3));
    const skidN = clamp(p.skid / 3.5, 0, 1);
    this.trail.add(this.tmp, r, n, lerp(0.07, 0.36, skidN), skidN, this.clock);
    // Schneespray abhängig von Kantendruck und Rutschen
    const rate = (p.skid * 16 + Math.max(0, p.edgePressure - 0.25) * p.speed * 2.4) * (this.preset.particles / 4000 + 0.3);
    this.sprayAcc += rate * FIX;
    while (this.sprayAcc >= 1) {
      this.sprayAcc -= 1;
      const along = (Math.random() - 0.5) * 1.3, out = -es * (1.5 + p.skid * 0.55 + Math.random() * 1.5), upv = 1.0 + Math.random() * 2.2 + p.skid * 0.25;
      const bx = p.pos.x + r.x * es * 0.13 + f.x * along, by = p.pos.y + 0.05, bz = p.pos.z + r.z * es * 0.13 + f.z * along;
      this.particles.emit(bx, by, bz,
        p.vel.x * 0.55 + r.x * out + n.x * upv + (Math.random() - 0.5), p.vel.y * 0.55 + r.y * out + n.y * upv, p.vel.z * 0.55 + r.z * out + n.z * upv + (Math.random() - 0.5),
        0.6 + Math.random() * 0.7, 0.12 + Math.random() * 0.18 + p.skid * 0.02);
    }
  }
  showFinish() {
    this.state = 'finished';
    const s = this.score, best = this.getBest(), t = this.finishTime; let rec = '';
    if (!best || t < best.time) { rec = 'New Best Time!'; if (this.ghostRec && this.ghostRec.length) this.ghost.save(this.ghostRec, t); try { localStorage.setItem(storeKey('best'), JSON.stringify({ time: t, score: Math.floor(s.score) })); } catch (e) {} }
    $('fRec').textContent = rec;
    const riv = this.rivals.filter((rv) => rv.active);
    const rows = [...(riv.length ? [['Platz', this.rank + ' / ' + (riv.length + 1)]] : []), ['Zeit', fmtTime(t)], ['Penalty Time', '+' + this.penalty.toFixed(0) + ' s'], ['Score', Math.floor(s.score).toLocaleString('en-US')],
      ['Top Speed', Math.round(s.topSpeed) + ' km/h'], ['Near Misses', s.nearMiss], ['Clean Carves', s.carves], ['Airtime', s.airTotal.toFixed(1) + ' s'], ['Flips / Grabs', s.flips + ' / ' + s.grabs], ['Gates', this.chal.passed + ' / ' + this.chal.gates.length], ['Stars', this.chal.got + ' / ' + this.chal.stars.length], ['Crashes', s.crashes],
      ['Bestzeit', fmtTime(best && best.time < t ? best.time : t)], ...riv.map((rv) => [rv.def.name, rv.finished ? fmtTime(rv.time) : 'Racing'])];
    $('fStats').innerHTML = rows.map(r => '<div>' + r[0] + '</div><div>' + r[1] + '</div>').join('');
    $('finish').classList.add('on'); $('hud').classList.remove('on');
  }
  autoAdjust(dtReal) {
    this.fpsFrames++; this.fpsTime += dtReal;
    if (this.fpsTime < 2.5) return;
    const fps = this.fpsFrames / this.fpsTime; this.fpsFrames = 0; this.fpsTime = 0;
    if (!this.autoPreset || this.state !== 'play') return;
    if (fps < CONFIG.autoPresetFps) { if (++this.lowCount >= 2) { const order = ['low', 'medium', 'high'], i = order.indexOf(this.presetName); if (i > 0) { this.applyPreset(order[i - 1]); this.hud.toast('Graphics: ' + order[i - 1] + ' (auto, ' + Math.round(fps) + ' FPS)'); } this.lowCount = 0; } }
    else this.lowCount = 0;
  }
}

// Fehler-Overlay (antippen schließt es). "Script error." ohne Datei stammt aus fremden Skripten (CDN, Erweiterungen) und enthält keine Details -> nur Konsole
addEventListener('error', (e) => {
  if (!e.filename && /^Script error\.?$/i.test(e.message || '')) { console.warn('Fremdes Skript meldete einen Fehler ohne Details'); return; }
  const el = $('err'); el.style.display = 'block'; el.textContent = 'Error: ' + (e.message || e) + (e.filename ? '\n' + e.filename + ':' + e.lineno : '') + '\n(tap to close)';
});
$('err').onclick = () => { $('err').style.display = 'none'; };
window.game = new Game();

// PWA: Service Worker (offline spielbar) – nur über HTTPS oder localhost; Install-Knopf, sobald der Browser es anbietet
if ('serviceWorker' in navigator && (location.protocol === 'https:' || ['localhost', '127.0.0.1'].includes(location.hostname)))
  navigator.serviceWorker.register('sw.js').catch((e) => console.warn('Service worker registration failed', e));
let installPrompt = null;
addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installPrompt = e; $('bInstall').style.display = ''; });
addEventListener('appinstalled', () => { installPrompt = null; $('bInstall').style.display = 'none'; });
$('bInstall').onclick = async () => { if (!installPrompt) return; installPrompt.prompt(); await installPrompt.userChoice; installPrompt = null; $('bInstall').style.display = 'none'; };
</script>

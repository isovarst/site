}

/* =====================================================================
   CameraRig — Follow / Action-Cam / Helmkamera, gedämpft, Speed-FOV, Shake
   ===================================================================== */
const CAM_NAMES = ['VERFOLGER', 'ACTION', 'HELM'];
class CameraRig {
  constructor(camera, course) {
    this.cam = camera; this.course = course; this.mode = 0;
    this.pos = new THREE.Vector3(); this.look = new THREE.Vector3(); this.dir = new THREE.Vector3(0, 0, 1);
    this.fov = CONFIG.fovBase; this.trauma = 0; this.t = 0; this.roll = 0;
    this._d = new THREE.Vector3(); this._side = new THREE.Vector3(); this._tmp = new THREE.Vector3(); this._up = new THREE.Vector3(0, 1, 0);
  }
  addTrauma(x) { this.trauma = Math.min(1, this.trauma + x); }
  snap(tg) { this.update(1, tg, true); }
  update(dt, tg, snap = false) {
    const C = CONFIG, kmh = tg.speed * 3.6; this.t += dt;

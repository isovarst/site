    const d = this._d; if (tg.speed > 2.5) d.set(tg.vel.x, 0, tg.vel.z).normalize(); else d.copy(tg.heading);
    if (snap) this.dir.copy(d); else this.dir.lerp(d, 1 - Math.exp(-3.0 * dt)).normalize();
    const side = this._side.crossVectors(this.dir, this._up);
    let desiredLambda = 6, fovT = C.fovBase + kmh * C.fovSpeed, lookLambda = 10;
    const want = this._tmp; let lx, ly, lz;
    const mode = tg.crashed && this.mode === 2 ? 0 : this.mode;
    if (mode === 0) {
      const dist = C.camDistance + tg.speed * 0.05 + (tg.crashed ? 2 : 0), hgt = C.camHeight + tg.speed * 0.012 + (tg.crashed ? 1 : 0);
      want.copy(tg.focus).addScaledVector(this.dir, -dist); want.y += hgt;
      lx = tg.focus.x + this.dir.x * 6; ly = tg.focus.y + 0.9; lz = tg.focus.z + this.dir.z * 6;
    } else if (mode === 1) {
      want.copy(tg.focus).addScaledVector(this.dir, -2.5).addScaledVector(side, 0.6); want.y += 0.55;
      lx = tg.focus.x + this.dir.x * 8; ly = tg.focus.y + 0.7; lz = tg.focus.z + this.dir.z * 8;
      desiredLambda = 12; fovT += 16;
    } else {
      want.copy(tg.head).addScaledVector(tg.lookDir, RIG.headR); want.y += 0.04;
      lx = tg.head.x + tg.lookDir.x * 10; ly = tg.head.y + tg.lookDir.y * 10 - 0.8; lz = tg.head.z + tg.lookDir.z * 10;
      desiredLambda = 40; lookLambda = 14; fovT += 20;
    }
    const gh = this.course.height(want.x, want.z) + (mode === 1 ? 0.25 : 0.7); if (want.y < gh) want.y = gh;
    if (snap) { this.pos.copy(want); this.look.set(lx, ly, lz); this.fov = fovT; }
    else {
      this.pos.x = damp(this.pos.x, want.x, desiredLambda, dt); this.pos.y = damp(this.pos.y, want.y, desiredLambda, dt); this.pos.z = damp(this.pos.z, want.z, desiredLambda, dt);
      this.look.x = damp(this.look.x, lx, lookLambda, dt); this.look.y = damp(this.look.y, ly, lookLambda, dt); this.look.z = damp(this.look.z, lz, lookLambda, dt);
      this.fov = damp(this.fov, Math.min(fovT, C.fovMax + (mode ? 12 : 0)), 3, dt);
    }

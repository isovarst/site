    this.cam.position.copy(this.pos); this.cam.position.x += ox * side.x; this.cam.position.z += ox * side.z; this.cam.position.y += oy;
    this.cam.lookAt(this.look);
    this.roll = damp(this.roll, mode === 0 ? clamp(-tg.latAcc * 0.006, -0.08, 0.08) : clamp(-tg.latAcc * 0.012, -0.2, 0.2), 4, dt);
    this.cam.rotateZ(this.roll + tr * Math.sin(t * 29) * 0.04);
    if (Math.abs(this.cam.fov - this.fov) > 0.01) { this.cam.fov = this.fov; this.cam.updateProjectionMatrix(); }
  }
}

/* =====================================================================
   HUD — DOM-Overlay im Broadcast-Stil
   ===================================================================== */
const $ = (id) => document.getElementById(id);
const fmtTime = (t) => { const m = Math.floor(t / 60), s = t - m * 60; return m + ':' + (s < 10 ? '0' : '') + s.toFixed(2); };
class HUD {
  constructor() {
    this.el = { T: $('hT'), Pen: $('hPen'), Prog: $('hProgBar'), Dist: $('hDist'), Extra: $('hExtra'), S: $('hS'), Combo: $('hCombo'), V: $('hV'), G: $('hGaugeBar'), Cam: $('hCam'), count: $('count'), toast: $('toast'), slow: $('slowmo') };
    this.pops = []; const box = $('pops');
    for (let i = 0; i < 5; i++) { const d = document.createElement('div'); d.className = 'pop'; box.appendChild(d); this.pops.push({ d, t: 0 }); }
    this.pi = 0; this.acc = 0; this.last = {}; this.toastT = 0;
  }
  set(k, v) { if (this.last[k] !== v) { this.last[k] = v; this.el[k].textContent = v; } }
  pop(text, sub = '', bad = false) {
    const p = this.pops[this.pi]; this.pi = (this.pi + 1) % this.pops.length;
    p.d.innerHTML = text + (sub ? '<small>' + sub + '</small>' : ''); p.d.classList.toggle('bad', bad);
    p.d.parentNode.appendChild(p.d); p.d.classList.remove('show'); void p.d.offsetWidth; p.d.classList.add('show'); p.t = 1.5;
  }
  toast(text) { this.el.toast.textContent = text; this.el.toast.style.opacity = 1; this.toastT = 2.5; }
  countdown(text, on) { this.el.count.textContent = text; this.el.count.style.opacity = on ? 1 : 0; }
  update(dt, g) {
    for (const p of this.pops) if (p.t > 0) { p.t -= dt; if (p.t <= 0) p.d.classList.remove('show'); }
    if (this.toastT > 0 && (this.toastT -= dt) <= 0) this.el.toast.style.opacity = 0;
    this.el.slow.style.opacity = g.timeScale < 0.9 ? 1 : 0;
    this.acc += dt; if (this.acc < 1 / 15) return; this.acc = 0;
    const kmh = g.riderMode === 'ride' ? Math.round(g.phys.speed * 3.6) : 0;
    this.set('T', fmtTime(g.finished ? g.finishTime - g.penalty : g.runTime));
    this.set('Pen', g.penalty > 0 ? '+' + g.penalty.toFixed(0) + 's' : '');
    this.set('V', String(kmh)); this.el.G.style.width = clamp(kmh / 130, 0, 1) * 100 + '%';
    this.set('S', String(Math.floor(g.score.score)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'));
    this.set('Combo', 'x' + g.score.combo + (g.score.comboT > 0 && g.score.combo > 1 ? '  ' + '▮'.repeat(Math.ceil(g.score.comboT)) : ''));
    const dist = clamp(g.phys.pos.z - 4, 0, CONFIG.courseLength);
    this.el.Prog.style.width = (dist / CONFIG.courseLength * 100).toFixed(1) + '%';
    this.set('Dist', Math.round(dist) + ' m  /  ' + CONFIG.courseLength + ' m');
    this.set('Extra', 'Gates ' + g.chal.passed + '/' + g.chal.gates.length + '  ·  ★ ' + g.chal.got + '/' + g.chal.stars.length + (g.rivalText ? '  ·  ' + g.rivalText : ''));
  }
}

/* =====================================================================
   Score — Speed, Near Miss, Carving, Airtime, Combo
   ===================================================================== */
class Score {
  constructor(hud, audio) { this.hud = hud; this.audio = audio; this.reset(); }
  reset() { this.score = 0; this.combo = 1; this.comboT = 0; this.comboP = 0; this.nearMiss = 0; this.crashes = 0; this.airTotal = 0; this.topSpeed = 0; this.carves = 0; this.carveT = 0; this.carveSign = 0; this.bestAir = 0; this.flips = 0; this.grabs = 0; this.stars = 0; }
  bump(p) { this.comboP += p; while (this.comboP >= 1) { this.comboP -= 1; this.combo = Math.min(CONFIG.comboMax, this.combo + 1); } this.comboT = CONFIG.comboTime; }
  add(pts) { const v = Math.round(pts * this.combo); this.score += v; return v; }
  update(dt, phys, riding) {
    const kmh = phys.speed * 3.6; if (riding) this.topSpeed = Math.max(this.topSpeed, kmh);
    if (this.comboT > 0 && (this.comboT -= dt) <= 0) { this.combo = 1; this.comboP = 0; }

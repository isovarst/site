    g.setAttribute('on', new THREE.BufferAttribute(this.O, 1)); g.setAttribute('side', new THREE.BufferAttribute(this.U, 1)); g.setAttribute('kind', new THREE.BufferAttribute(this.K, 1));
    const idx = []; for (let i = 0; i < n; i++) { const a = i * 2, b = ((i + 1) % n) * 2; idx.push(a, b, a + 1, a + 1, b, b + 1); }

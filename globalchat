function redrawBoard(){if(!canvas.width||!canvas.height)return;const rect=stage.getBoundingClientRect(),dpr=canvas.width/Math.max(1,rect.width);ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#ffffff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.setTransform(dpr*zoom,0,0,dpr*zoom,dpr*panX,dpr*panY);boardStrokes.forEach(stroke=>drawStroke(stroke));if(currentStroke)drawStroke(currentStroke);if(gridVisible){ctx.setTransform(1,0,0,1,0,0);const step=40*zoom;ctx.globalAlpha=.72;ctx.fillStyle='#dedede';if(step>7){const ox=((panX*dpr)%step+step)%step,oy=((panY*dpr)%step+step)%step;for(let x=ox;x<canvas.width;x+=step)ctx.fillRect(x,0,Math.max(1,dpr*.45),canvas.height);for(let y=oy;y<canvas.height;y+=step)ctx.fillRect(0,y,canvas.width,Math.max(1,dpr*.45))}ctx.globalAlpha=1}renderCursors()}
function renderCursors(){cursorLayer.innerHTML='';const now=Date.now();for(const[id,c]of remoteCursors){if(id===myId)continue;if(now-c.time>7000){remoteCursors.delete(id);continue}const el=document.createElement('div');el.className='remote-cursor';el.style.left=(c.x*zoom+panX)+'px';el.style.top=(c.y*zoom+panY)+'px';const dot=document.createElement('i'),label=document.createElement('span');label.textContent=c.name;el.append(dot,label);cursorLayer.append(el)}}
function sendCursor(e){const p=worldPoint(e),now=Date.now();if(now-lastCursorSent<45)return;lastCursorSent=now;if(isHost){remoteCursors.set(myId,{...p,name:myName,time:now});sendAll({type:'board-cursor',from:myId,...p,name:myName})}else if(ready)sendAll(packet('board-cursor',p))}
function setZoom(next,ax=stage.clientWidth/2,ay=stage.clientHeight/2){const z=Math.max(.2,Math.min(5,next)),wx=(ax-panX)/zoom,wy=(ay-panY)/zoom;zoom=z;panX=ax-wx*zoom;panY=ay-wy*zoom;$('zoomLabel').textContent=Math.round(zoom*100)+'%';resizeBoard()}
function setTool(mode){toolMode=mode;panMode=mode==='pan';eraser=mode==='eraser';[['penBtn','pen'],['eraserBtn','eraser'],['panBtn','pan'],['lineBtn','line'],['rectBtn','rect'],['circleBtn','circle'],['bucketBtn','bucket'],['highlighterBtn','highlighter'],['textBtn','text']].forEach(([id,m])=>$(id).classList.toggle('active',mode===m));stage.classList.toggle('panning',mode==='pan'||spaceDown);stage.style.cursor=mode==='pan'||spaceDown?'grab':mode==='text'?'text':'crosshair'}
function beginPan(e){panning=true;activePointerId=e.pointerId;panStart={x:e.clientX,y:e.clientY,px:panX,py:panY};try{stage.setPointerCapture(e.pointerId)}catch(err){}stage.classList.add('panning')}
function finishPointer(e){if(activePointerId!==null&&e&&e.pointerId!==activePointerId)return;if(panning){panning=false;panStart=null;activePointerId=null;stage.classList.toggle('panning',toolMode==='pan'||spaceDown);return}if(!drawing||!currentStroke)return;drawing=false;activePointerId=null;const stroke=currentStroke;currentStroke=null;boardStrokes.push(stroke);if(boardStrokes.length>3000)boardStrokes.shift();if(isHost)sendAll({type:'board-stroke',stroke});else if(ready)sendAll(packet('board-stroke',{stroke}));else offlineStrokes.push(stroke);redrawBoard()}
stage.addEventListener('contextmenu',e=>e.preventDefault());stage.addEventListener('pointerdown',e=>{if(e.target.closest('.board-toolbar'))return;if(e.button===1||e.button===2||spaceDown||toolMode==='pan'){e.preventDefault();beginPan(e);return}if(e.button!==0)return;e.preventDefault();const p=worldPoint(e);if(toolMode==='bucket'){const r=stage.getBoundingClientRect();paintBucket(e.clientX-r.left,e.clientY-r.top);return}if(toolMode==='text'){const value=prompt('Enter text to place on the board');if(value?.trim()){const stroke={color:$('drawColor').value,size:Number($('drawSize').value),opacity:Number($('drawOpacity').value)/100,text:value.trim().slice(0,300),x:p.x,y:p.y};boardStrokes.push(stroke);if(isHost)sendAll({type:'board-stroke',stroke});else if(ready)sendAll(packet('board-stroke',{stroke}));else offlineStrokes.push(stroke);redrawBoard()}return}drawing=true;activePointerId=e.pointerId;try{stage.setPointerCapture(e.pointerId)}catch(err){}currentStroke={color:$('drawColor').value,size:Number($('drawSize').value)*(toolMode==='highlighter'?2.5:1),opacity:toolMode==='highlighter'?.24:Number($('drawOpacity').value)/100,erase:toolMode==='eraser',shape:['line','rect','circle'].includes(toolMode)?toolMode:null,start:p,end:p,points:[p]};redrawBoard()});
stage.addEventListener('pointermove',e=>{if(e.target.closest?.('.board-toolbar'))return;const p=worldPoint(e);$('coordsLabel').textContent='x: '+Math.round(p.x)+' · y: '+Math.round(p.y);sendCursor(e);if(panning&&panStart&&e.pointerId===activePointerId){panX=panStart.px+(e.clientX-panStart.x);panY=panStart.py+(e.clientY-panStart.y);redrawBoard();return}if(!drawing||!currentStroke||e.pointerId!==activePointerId)return;if(currentStroke.shape){currentStroke.end=p;redrawBoard();return}const prev=currentStroke.points[currentStroke.points.length-1];if(Math.hypot(p.x-prev.x,p.y-prev.y)>.15){if(currentStroke.points.length<3000)currentStroke.points.push({x:Math.round(p.x*100)/100,y:Math.round(p.y*100)/100});redrawBoard()}});
stage.addEventListener('pointerup',finishPointer);stage.addEventListener('pointercancel',finishPointer);stage.addEventListener('lostpointercapture',e=>{if(drawing||panning)finishPointer(e)});
stage.addEventListener('wheel',e=>{e.preventDefault();const r=stage.getBoundingClientRect();setZoom(zoom*(e.deltaY<0?1.12:.89),e.clientX-r.left,e.clientY-r.top)},{passive:false});window.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA'].includes(document.activeElement.tagName))return;if(e.code==='Space'){spaceDown=true;stage.classList.add('panning');stage.style.cursor='grab';e.preventDefault()}if(e.ctrlKey&&e.key.toLowerCase()==='z'){e.preventDefault();$('undoBtn').click()}if(e.key.toLowerCase()==='b')setTool('pen');if(e.key.toLowerCase()==='e')setTool('eraser');if(e.key.toLowerCase()==='h')setTool('pan');if(e.key.toLowerCase()==='l')setTool('line');if(e.key.toLowerCase()==='r')setTool('rect');if(e.key.toLowerCase()==='o')setTool('circle');if(e.key.toLowerCase()==='g')setTool('bucket');if(e.key.toLowerCase()==='t')setTool('text')});window.addEventListener('keyup',e=>{if(e.code==='Space'){spaceDown=false;stage.classList.toggle('panning',toolMode==='pan');stage.style.cursor=toolMode==='pan'?'grab':'crosshair'}});window.addEventListener('blur',()=>{spaceDown=false;if(panning||drawing)finishPointer({pointerId:activePointerId});stage.classList.toggle('panning',toolMode==='pan')});window.addEventListener('resize',resizeBoard);if('ResizeObserver'in window)new ResizeObserver(resizeBoard).observe(stage);
$('penBtn').onclick=()=>setTool('pen');$('eraserBtn').onclick=()=>setTool('eraser');$('panBtn').onclick=()=>setTool(toolMode==='pan'?'pen':'pan');$('lineBtn').onclick=()=>setTool('line');$('rectBtn').onclick=()=>setTool('rect');$('circleBtn').onclick=()=>setTool('circle');$('textBtn').onclick=()=>setTool('text');$('bucketBtn').onclick=()=>setTool('bucket');$('highlighterBtn').onclick=()=>setTool('highlighter');$('drawSize').addEventListener('input',()=>$('sizeValue').textContent=$('drawSize').value);$('drawOpacity').addEventListener('input',()=>{$('opacityValue').textContent=$('drawOpacity').value+'%'});$('gridBtn').onclick=()=>{gridVisible=!gridVisible;$('gridBtn').classList.toggle('active',gridVisible);redrawBoard()};$('zoomIn').onclick=()=>setZoom(zoom*1.2);$('zoomOut').onclick=()=>setZoom(zoom/1.2);$('zoomReset').onclick=()=>{zoom=1;panX=0;panY=0;$('zoomLabel').textContent='100%';resizeBoard()};$('boardDone').onclick=()=>{ $('whiteboardView').classList.add('hidden');$('chatView').classList.remove('hidden');document.querySelector('[data-tab="chat"]').classList.add('active');document.querySelector('[data-tab="whiteboard"]').classList.remove('active')};$('undoBtn').onclick=()=>{if(!boardStrokes.length)return;if(isHost){boardStrokes.pop();redrawBoard();sendAll({type:'board-state',strokes:boardStrokes})}else if(ready)sendAll(packet('board-undo'));else{boardStrokes.pop();offlineStrokes.pop();redrawBoard()}};$('exportBoard').onclick=()=>{const a=document.createElement('a');a.download='whiteboard.png';a.href=canvas.toDataURL('image/png');a.click()};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{const board=b.dataset.tab==='whiteboard';$('chatView').classList.toggle('hidden',board);$('whiteboardView').classList.toggle('hidden',!board);document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t===b));if(board)requestAnimationFrame(resizeBoard)});
setInterval(()=>{if(isHost){for(const[id,t]of lastSeen){if(Date.now()-t>25000){const c=peers.get(id);if(c)try{c.close()}catch(e){}removePeer(id)}}sendAll({type:'host-ping'})}else if(ready){const h=peers.get('host');if(h?.open)try{h.send({type:'ping'})}catch(e){}if(Date.now()-lastHostPing>20000){cleanPeer();addSystem('host connection timed out. reconnecting…');scheduleReconnect(session)}}showTyping();renderCursors()},5000);
setTool('pen');resizeBoard();updatePeople();
})();
